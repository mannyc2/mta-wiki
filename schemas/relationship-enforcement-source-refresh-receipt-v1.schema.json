{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relationship-enforcement-source-refresh-receipt-v1.schema.json",
  "title": "Relationship enforcement source refresh receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "contract_id",
    "reason_code",
    "review_method",
    "previous_active_proof",
    "coverage_manifest",
    "completeness_manifest",
    "completeness_summary",
    "report",
    "unchanged_row_artifacts",
    "allowed_json_pointer_changes",
    "public_snapshot_input_closure"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "const": "relationship-contract-v1-enforcement-source-refresh" },
    "contract_id": { "const": "relationship-contract-v1" },
    "reason_code": { "const": "public_snapshot_pin_closure" },
    "review_method": { "const": "lossless_public_snapshot_pin_refresh" },
    "previous_active_proof": { "$ref": "#/$defs/proofReference" },
    "previous_source_refresh_receipt": { "$ref": "#/$defs/reference" },
    "coverage_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "previous", "current"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "previous": { "$ref": "#/$defs/fileVersion" },
        "current": { "$ref": "#/$defs/fileVersion" }
      }
    },
    "completeness_manifest": { "$ref": "#/$defs/changePin" },
    "completeness_summary": { "$ref": "#/$defs/changePin" },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "previous_sha256",
        "current_sha256",
        "previous_command",
        "current_command",
        "exact_removed_line",
        "exact_added_line"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "previous_sha256": { "$ref": "#/$defs/sha256" },
        "current_sha256": { "$ref": "#/$defs/sha256" },
        "previous_command": { "type": "string", "minLength": 1 },
        "current_command": { "type": "string", "minLength": 1 },
        "exact_removed_line": { "type": "string", "minLength": 2 },
        "exact_added_line": { "type": "string", "minLength": 2 }
      }
    },
    "unchanged_row_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "row_count"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "row_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "allowed_json_pointer_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_path",
          "json_pointer",
          "previous_value",
          "current_value"
        ],
        "properties": {
          "artifact_path": { "$ref": "#/$defs/path" },
          "json_pointer": { "type": "string", "pattern": "^/" },
          "previous_value": {},
          "current_value": {}
        }
      }
    },
    "public_snapshot_input_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "proofReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "proof_stage"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "proof_stage": { "const": "post_promotion_enforced" }
      }
    },
    "fileVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "changePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "previous_sha256", "current_sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "previous_sha256": { "$ref": "#/$defs/sha256" },
        "current_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
